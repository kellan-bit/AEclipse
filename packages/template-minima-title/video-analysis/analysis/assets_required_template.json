{
  "$schema": "Asset manifest template - Claude fills this when analyzing frames containing images/videos",
  "assets": [
    {
      "id": "asset_001",
      "type": "photo|logo|video|graphic|texture",
      "description": "Detailed description of the asset",
      "subject": "What the image shows",
      "style": "Photography/design style notes",

      "appearance": {
        "scenes": [1, 2],
        "firstFrame": 120,
        "firstTimestamp": "00:00:04.000",
        "lastFrame": 240,
        "lastTimestamp": "00:00:08.000",
        "totalDuration": 120
      },

      "visualProperties": {
        "aspectRatio": "16:9",
        "estimatedResolution": "1920x1080",
        "hasTransparency": false,
        "colorProfile": "warm|cool|neutral|bw"
      },

      "animationApplied": {
        "scale": {
          "enabled": true,
          "startValue": 1.0,
          "endValue": 1.1,
          "description": "Slow zoom in (Ken Burns)"
        },
        "position": {
          "enabled": true,
          "startX": "50%",
          "startY": "50%",
          "endX": "48%",
          "endY": "50%",
          "description": "Subtle pan left"
        },
        "opacity": {
          "enabled": true,
          "fadeIn": 15,
          "fadeOut": 15
        },
        "mask": {
          "enabled": false,
          "type": null,
          "description": null
        },
        "filter": {
          "blur": false,
          "colorGrade": "slight warmth"
        }
      },

      "source": {
        "suggestedFilename": "descriptive-name.jpg",
        "format": "jpg|png|webp|mp4",
        "minimumResolution": "1920x1080",
        "notes": "Original high-res preferred"
      },

      "status": "needed|provided|extracted",
      "providedPath": null,
      "extractedFallback": null
    }
  ],

  "summary": {
    "photos": 0,
    "logos": 0,
    "videoClips": 0,
    "graphics": 0,
    "textures": 0,
    "total": 0,
    "needed": 0,
    "provided": 0
  },

  "extractionCommands": {
    "_comment": "FFmpeg commands to extract frames if originals unavailable",
    "asset_001": "ffmpeg -ss 00:00:04 -i input/source-video.mp4 -vframes 1 public/assets/extracted_001.png"
  },

  "remotionReferences": {
    "_comment": "How to reference assets in Remotion code",
    "example": "const assetSrc = staticFile('assets/descriptive-name.jpg');"
  }
}
